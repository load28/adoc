{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://adoc.local/contracts/document-content.schema.json",
  "x-document-id": "CONTRACT-01",
  "title": "DocumentContent",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "root"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "root": { "$ref": "#/$defs/doc" }
  },
  "$defs": {
    "id": { "type": "string", "format": "uuid" },
    "doc": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "children"],
      "properties": {
        "type": { "const": "doc" },
        "children": { "type": "array", "maxItems": 50000, "items": { "$ref": "#/$defs/block" } }
      }
    },
    "block": {
      "oneOf": [
        { "$ref": "#/$defs/paragraph" }, { "$ref": "#/$defs/heading" },
        { "$ref": "#/$defs/quote" }, { "$ref": "#/$defs/callout" },
        { "$ref": "#/$defs/list" }, { "$ref": "#/$defs/codeBlock" },
        { "$ref": "#/$defs/table" }, { "$ref": "#/$defs/toggle" },
        { "$ref": "#/$defs/divider" }, { "$ref": "#/$defs/image" },
        { "$ref": "#/$defs/file" }
      ]
    },
    "inline": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false,
          "required": ["type", "text"],
          "properties": {
            "type": { "const": "text" }, "text": { "type": "string", "maxLength": 1000000 },
            "marks": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/mark" } }
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["type"],
          "properties": { "type": { "const": "hardBreak" } }
        }
      ]
    },
    "mark": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["type"], "properties": { "type": { "enum": ["bold", "italic", "underline", "strike", "code", "subscript", "superscript"] } } },
        { "type": "object", "additionalProperties": false, "required": ["type", "href"], "properties": { "type": { "const": "link" }, "href": { "type": "string", "format": "uri", "maxLength": 2048 }, "title": { "type": ["string", "null"], "maxLength": 240 } } },
        { "type": "object", "additionalProperties": false, "required": ["type", "token"], "properties": { "type": { "enum": ["highlight", "textColor"] }, "token": { "type": "string", "pattern": "^[a-z][a-zA-Z0-9.]*$" } } }
      ]
    },
    "textChildren": { "type": "array", "maxItems": 100000, "items": { "$ref": "#/$defs/inline" } },
    "paragraph": {
      "type": "object", "additionalProperties": false, "required": ["id", "type", "children"],
      "properties": { "id": { "$ref": "#/$defs/id" }, "type": { "const": "paragraph" }, "children": { "$ref": "#/$defs/textChildren" } }
    },
    "heading": {
      "type": "object", "additionalProperties": false, "required": ["id", "type", "level", "children"],
      "properties": { "id": { "$ref": "#/$defs/id" }, "type": { "const": "heading" }, "level": { "type": "integer", "minimum": 1, "maximum": 6 }, "children": { "$ref": "#/$defs/textChildren" } }
    },
    "quote": {
      "type": "object", "additionalProperties": false, "required": ["id", "type", "children"],
      "properties": { "id": { "$ref": "#/$defs/id" }, "type": { "const": "quote" }, "children": { "type": "array", "minItems": 1, "items": { "oneOf": [{ "$ref": "#/$defs/paragraph" }, { "$ref": "#/$defs/list" }] } } }
    },
    "callout": {
      "type": "object", "additionalProperties": false, "required": ["id", "type", "tone", "children"],
      "properties": { "id": { "$ref": "#/$defs/id" }, "type": { "const": "callout" }, "tone": { "enum": ["info", "success", "warning", "danger", "note"] }, "icon": { "type": ["string", "null"], "maxLength": 64 }, "children": { "type": "array", "minItems": 1, "items": { "oneOf": [{ "$ref": "#/$defs/paragraph" }, { "$ref": "#/$defs/list" }] } } }
    },
    "list": {
      "type": "object", "additionalProperties": false, "required": ["id", "type", "items"],
      "properties": { "id": { "$ref": "#/$defs/id" }, "type": { "enum": ["bulletList", "orderedList", "taskList"] }, "start": { "type": "integer", "minimum": 1 }, "items": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/listItem" } } }
    },
    "listItem": {
      "type": "object", "additionalProperties": false, "required": ["id", "type", "children"],
      "properties": { "id": { "$ref": "#/$defs/id" }, "type": { "const": "listItem" }, "checked": { "type": ["boolean", "null"] }, "children": { "type": "array", "minItems": 1, "items": { "oneOf": [{ "$ref": "#/$defs/paragraph" }, { "$ref": "#/$defs/list" }] } } }
    },
    "codeBlock": {
      "type": "object", "additionalProperties": false, "required": ["id", "type", "text"],
      "properties": { "id": { "$ref": "#/$defs/id" }, "type": { "const": "codeBlock" }, "language": { "type": ["string", "null"], "maxLength": 64 }, "text": { "type": "string", "maxLength": 2000000 } }
    },
    "table": {
      "type": "object", "additionalProperties": false, "required": ["id", "type", "rows"],
      "properties": { "id": { "$ref": "#/$defs/id" }, "type": { "const": "table" }, "rows": { "type": "array", "minItems": 1, "maxItems": 1000, "items": { "$ref": "#/$defs/tableRow" } } }
    },
    "tableRow": {
      "type": "object", "additionalProperties": false, "required": ["id", "type", "cells"],
      "properties": { "id": { "$ref": "#/$defs/id" }, "type": { "const": "tableRow" }, "cells": { "type": "array", "minItems": 1, "maxItems": 100, "items": { "$ref": "#/$defs/tableCell" } } }
    },
    "tableCell": {
      "type": "object", "additionalProperties": false, "required": ["id", "type", "children"],
      "properties": { "id": { "$ref": "#/$defs/id" }, "type": { "enum": ["tableCell", "tableHeader"] }, "colspan": { "type": "integer", "minimum": 1, "maximum": 100 }, "rowspan": { "type": "integer", "minimum": 1, "maximum": 1000 }, "children": { "type": "array", "minItems": 1, "items": { "oneOf": [{ "$ref": "#/$defs/paragraph" }, { "$ref": "#/$defs/list" }, { "$ref": "#/$defs/codeBlock" }] } } }
    },
    "toggle": {
      "type": "object", "additionalProperties": false, "required": ["id", "type", "summary", "children"],
      "properties": { "id": { "$ref": "#/$defs/id" }, "type": { "const": "toggle" }, "summary": { "$ref": "#/$defs/textChildren" }, "children": { "type": "array", "items": { "$ref": "#/$defs/block" } } }
    },
    "divider": { "type": "object", "additionalProperties": false, "required": ["id", "type"], "properties": { "id": { "$ref": "#/$defs/id" }, "type": { "const": "divider" } } },
    "image": {
      "type": "object", "additionalProperties": false, "required": ["id", "type", "assetId", "alt"],
      "properties": { "id": { "$ref": "#/$defs/id" }, "type": { "const": "image" }, "assetId": { "$ref": "#/$defs/id" }, "alt": { "type": "string", "maxLength": 1000 }, "caption": { "type": ["string", "null"], "maxLength": 2000 }, "width": { "type": ["integer", "null"], "minimum": 64, "maximum": 4096 } }
    },
    "file": {
      "type": "object", "additionalProperties": false, "required": ["id", "type", "assetId"],
      "properties": { "id": { "$ref": "#/$defs/id" }, "type": { "const": "file" }, "assetId": { "$ref": "#/$defs/id" }, "caption": { "type": ["string", "null"], "maxLength": 2000 } }
    }
  }
}
