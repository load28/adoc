{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://adoc.local/contracts/event-payloads.schema.json",
  "x-document-id": "CONTRACT-04",
  "title": "EventEnvelope",
  "type": "object", "additionalProperties": false,
  "required": ["eventId", "workspaceId", "aggregateId", "sequence", "type", "version", "occurredAt", "correlationId", "payload"],
  "properties": {
    "eventId": { "type": "string", "format": "uuid" },
    "workspaceId": { "type": "string", "format": "uuid" },
    "aggregateId": { "type": "string", "format": "uuid" },
    "sequence": { "type": "integer", "minimum": 1 },
    "type": { "enum": ["MEMBERSHIP_CHANGED", "GROUP_CHANGED", "PERMISSION_CHANGED", "PUBLISH_POLICY_CHANGED", "DOCUMENT_CHANGED", "DOCUMENT_MOVED", "DRAFT_CHANGED", "LEASE_CHANGED", "VERSION_PUBLISHED", "DISCUSSION_CHANGED", "REVIEW_CHANGED", "INBOX_CHANGED", "REFERENCE_CHANGED", "VOCABULARY_CHANGED", "AI_JOB_CHANGED", "PROPOSAL_APPLIED", "FILE_CHANGED", "PUBLIC_LINK_CHANGED", "PURGE_CHANGED"] },
    "version": { "const": 1 }, "occurredAt": { "type": "string", "format": "date-time" },
    "correlationId": { "type": "string", "minLength": 8, "maxLength": 128 },
    "payload": { "$ref": "#/$defs/payload" }
  },
  "allOf": [
    { "if": { "properties": { "type": { "enum": ["MEMBERSHIP_CHANGED", "GROUP_CHANGED", "PERMISSION_CHANGED", "PUBLISH_POLICY_CHANGED", "DOCUMENT_CHANGED", "DISCUSSION_CHANGED", "REVIEW_CHANGED", "INBOX_CHANGED", "REFERENCE_CHANGED", "VOCABULARY_CHANGED", "FILE_CHANGED", "PUBLIC_LINK_CHANGED"] } } }, "then": { "properties": { "payload": { "$ref": "#/$defs/entityChanged" } } } },
    { "if": { "properties": { "type": { "const": "DOCUMENT_MOVED" } } }, "then": { "properties": { "payload": { "$ref": "#/$defs/documentMoved" } } } },
    { "if": { "properties": { "type": { "const": "DRAFT_CHANGED" } } }, "then": { "properties": { "payload": { "$ref": "#/$defs/draftChanged" } } } },
    { "if": { "properties": { "type": { "const": "LEASE_CHANGED" } } }, "then": { "properties": { "payload": { "$ref": "#/$defs/leaseChanged" } } } },
    { "if": { "properties": { "type": { "const": "VERSION_PUBLISHED" } } }, "then": { "properties": { "payload": { "$ref": "#/$defs/versionPublished" } } } },
    { "if": { "properties": { "type": { "const": "AI_JOB_CHANGED" } } }, "then": { "properties": { "payload": { "$ref": "#/$defs/jobChanged" } } } },
    { "if": { "properties": { "type": { "const": "PROPOSAL_APPLIED" } } }, "then": { "properties": { "payload": { "$ref": "#/$defs/proposalApplied" } } } },
    { "if": { "properties": { "type": { "const": "PURGE_CHANGED" } } }, "then": { "properties": { "payload": { "$ref": "#/$defs/purgeChanged" } } } }
  ],
  "$defs": {
    "id": { "type": "string", "format": "uuid" },
    "revision": { "type": "integer", "minimum": 0 },
    "payload": { "oneOf": [
      { "$ref": "#/$defs/entityChanged" }, { "$ref": "#/$defs/documentMoved" },
      { "$ref": "#/$defs/draftChanged" }, { "$ref": "#/$defs/leaseChanged" },
      { "$ref": "#/$defs/versionPublished" }, { "$ref": "#/$defs/jobChanged" },
      { "$ref": "#/$defs/proposalApplied" }, { "$ref": "#/$defs/purgeChanged" }
    ] },
    "entityChanged": { "type": "object", "additionalProperties": false, "required": ["entityId", "revision", "action"], "properties": { "entityId": { "$ref": "#/$defs/id" }, "revision": { "$ref": "#/$defs/revision" }, "action": { "enum": ["CREATED", "UPDATED", "DELETED", "INVALIDATED", "RESTORED", "CLOSED", "REOPENED"] } } },
    "documentMoved": { "type": "object", "additionalProperties": false, "required": ["documentId", "beforeParentId", "afterParentId", "revision"], "properties": { "documentId": { "$ref": "#/$defs/id" }, "beforeParentId": { "type": ["string", "null"], "format": "uuid" }, "afterParentId": { "type": ["string", "null"], "format": "uuid" }, "revision": { "$ref": "#/$defs/revision" } } },
    "draftChanged": { "type": "object", "additionalProperties": false, "required": ["documentId", "draftId", "revision", "operationIds"], "properties": { "documentId": { "$ref": "#/$defs/id" }, "draftId": { "$ref": "#/$defs/id" }, "revision": { "$ref": "#/$defs/revision" }, "operationIds": { "type": "array", "items": { "$ref": "#/$defs/id" } } } },
    "leaseChanged": { "type": "object", "additionalProperties": false, "required": ["documentId", "holderUserId", "expiresAt", "revision"], "properties": { "documentId": { "$ref": "#/$defs/id" }, "holderUserId": { "type": ["string", "null"], "format": "uuid" }, "expiresAt": { "type": ["string", "null"], "format": "date-time" }, "revision": { "$ref": "#/$defs/revision" } } },
    "versionPublished": { "type": "object", "additionalProperties": false, "required": ["documentId", "versionId", "number", "sourceDraftRevision"], "properties": { "documentId": { "$ref": "#/$defs/id" }, "versionId": { "$ref": "#/$defs/id" }, "number": { "type": "integer", "minimum": 1 }, "sourceDraftRevision": { "$ref": "#/$defs/revision" } } },
    "jobChanged": { "type": "object", "additionalProperties": false, "required": ["jobId", "status", "jobSequence"], "properties": { "jobId": { "$ref": "#/$defs/id" }, "status": { "enum": ["QUEUED", "RUNNING", "CANCEL_REQUESTED", "SUCCEEDED", "FAILED", "CANCELLED", "TIMED_OUT"] }, "jobSequence": { "type": "integer", "minimum": 1 }, "phase": { "type": ["string", "null"] }, "queuePosition": { "type": ["integer", "null"], "minimum": 0 } } },
    "proposalApplied": { "type": "object", "additionalProperties": false, "required": ["proposalId", "documentId", "appliedOperationIds", "resultRevision"], "properties": { "proposalId": { "$ref": "#/$defs/id" }, "documentId": { "$ref": "#/$defs/id" }, "appliedOperationIds": { "type": "array", "items": { "$ref": "#/$defs/id" } }, "resultRevision": { "$ref": "#/$defs/revision" } } },
    "purgeChanged": { "type": "object", "additionalProperties": false, "required": ["targetKind", "targetId", "step", "status"], "properties": { "targetKind": { "enum": ["DOCUMENT", "WORKSPACE", "FILE"] }, "targetId": { "$ref": "#/$defs/id" }, "step": { "type": "string" }, "status": { "enum": ["STARTED", "COMPLETED", "FAILED"] } } }
  }
}
